{
  "name": "edupasi-voice-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Voice Teacher pentru EduPASI: explicații pedagogice generate și rostite, cu cache permanent în MongoDB.",
  "main": "src/server.mjs",
  "scripts": {
