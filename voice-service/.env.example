# AI Voice Teacher — configurație. Copiază în `.env` și completează.
# NU comite .env: conține secrete (e deja în .gitignore).

# --- Modelul care înțelege și explică lecția ---
GROQ_API_KEY=
VOICE_LLM_PROVIDER=groq
VOICE_LLM_MODEL=openai/gpt-oss-120b
# Alternativ, complet local (mai lent, fără cheie):
# VOICE_LLM_PROVIDER=ollama
# VOICE_LLM_MODEL=qwen3:30b-instruct

# --- Cache permanent ---
MONGODB_URI_EDUCONNECT=
VOICE_DB_NAME=edupasi

# --- Vocea (Piper, rulează pe CPU) ---
PIPER_PYTHON=./.voice-venv/bin/python
PIPER_MODEL=./.voice-models/ro_RO-raluca-high.onnx
PIPER_LENGTH_SCALE=1.0

# --- Serviciu ---
PORT=8099
# Gol = permite orice origine. În producție, listează exact site-urile.
VOICE_ALLOWED_ORIGINS=http://localhost:3000,https://edumat58.github.io
# URL-ul public al serviciului (apare în audioUrl trimis clientului)
VOICE_PUBLIC_URL=
VOICE_MAX_REPAIRS=2
